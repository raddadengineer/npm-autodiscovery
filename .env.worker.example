# ==============================================================================
# NPM Auto-Discovery — Remote Worker Node Configuration (.env)
# ==============================================================================

# Central Nginx Proxy Manager Official API Settings
# Point to your central NPM instance IP/hostname and admin port
NPM_URL=http://192.168.1.10:81
NPM_USER=admin@example.com
NPM_PASS=changeme
NPM_TIMEOUT=15s

# Docker Engine Socket on this worker node
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_TIMEOUT=10s

# Multi-Host / Remote Worker Node Configuration
# 1. Unique ID for this machine (prevents peer nodes from conflicting or deleting each other's routes)
HOST_ID=worker-node-01

# 2. IP or resolvable hostname of this worker node that central NPM can reach
HOST_IP=192.168.1.20

# 3. Automatically map container ports to published host ports for cross-host routing
USE_HOST_PORT=true

# Synchronization & Polling
POLL_INTERVAL=30s

# Global Defaults for Discovered Proxy Hosts
DEFAULT_FORWARD_SCHEME=http
DEFAULT_SSL_ENABLED=false
DEFAULT_SSL_FORCED=false
DEFAULT_WEBSOCKET=true
DEFAULT_BLOCK_EXPLOITS=true

# Automatic SSL Certificate Auto-Discovery & Domain Matching
AUTO_CERTIFICATE=true
AUTO_SSL_FORCED=true

# Container Label Prefix (Default: npm.)
LABEL_PREFIX=npm.

# Web Dashboard & REST API Server on this worker node
PORT=8080
LOG_LEVEL=info
