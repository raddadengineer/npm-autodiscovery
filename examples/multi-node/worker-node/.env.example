# Remote Worker Node Configuration
# Point to the central NPM instance on Host 1
NPM_URL=http://192.168.1.10:81
NPM_USER=admin@example.com
NPM_PASS=changeme

# Worker identity (prevents conflicts with central node or other workers)
HOST_ID=worker-01

# Worker host IP reachable by central NPM
HOST_IP=192.168.1.20

# Forward to published host ports
USE_HOST_PORT=true

PORT=8080
POLL_INTERVAL=30s
LOG_LEVEL=info
