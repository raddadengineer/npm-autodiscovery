# ==============================================================================
# NPM Auto-Discovery Environment Configuration
# ==============================================================================

# Nginx Proxy Manager Official API Settings
NPM_URL=http://nginx-proxy-manager:81
NPM_USER=admin@example.com
NPM_PASS=changeme
NPM_TIMEOUT=15s

# Docker Engine Socket
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_TIMEOUT=10s

# Shared Docker Network between NPM and managed containers
# When set, containers in this network will be reached using their network IP or Docker DNS name
NPM_NETWORK=npm-network

# Forward Host Resolution Strategy
# Options:
#   auto: Resolves container name if in NPM_NETWORK or custom bridge, falls back to IP
#   name: Always resolves container by name (e.g., "my-web-app")
#   ip:   Always resolves container by IP address (e.g., "172.20.0.4")
FORWARD_HOST_STRATEGY=auto

# Multi-Host / Multi-Node Cluster Configuration
# Set a unique HOST_ID for each machine running npm-autodiscovery (defaults to hostname if empty)
HOST_ID=worker-node-01

# Set HOST_IP if this agent is on a remote Docker host from NPM.
# NPM will forward incoming proxy traffic to this host IP/DNS and the container's published port.
HOST_IP=192.168.1.50

# Set to true to automatically route to published host port instead of internal container port
USE_HOST_PORT=true

# Synchronization & Polling
# Full scan interval (e.g., 30s, 60s, 5m)
POLL_INTERVAL=30s

# Global Defaults for Discovered Proxy Hosts
DEFAULT_FORWARD_SCHEME=http
DEFAULT_SSL_ENABLED=false
DEFAULT_SSL_FORCED=false
DEFAULT_WEBSOCKET=true
DEFAULT_BLOCK_EXPLOITS=true

# Automatic SSL Certificate Auto-Discovery & Domain Matching
# Automatically matches domains (e.g., *.halnt.dev, *.raddadengineer.com) against certificates in NPM.
# Domains without matching certs (e.g., *.local) remain HTTP Only.
AUTO_CERTIFICATE=true
AUTO_SSL_FORCED=true

# Container Label Prefix (Default: npm.)
LABEL_PREFIX=npm.

# Web Dashboard & REST API Server
PORT=8080
LOG_LEVEL=info
